{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/fibo/mcp",
        "function": {
          "functionId": "mcp",
          "region": "us-central1"
        }
      },
      {
        "source": "/fibo/**",
        "destination": "/fibo/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
